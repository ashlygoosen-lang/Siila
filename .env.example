PORT=3000
NODE_ENV=development
# REQUIRED in production: long random string (e.g. `openssl rand -hex 48`)
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
DB_PATH=./data/siira.db
# Comma-separated list of allowed origins; leave empty to allow same-origin only in production
CORS_ORIGIN=
# Seed demo data on first start when the database is empty
SEED_DEMO=true

# First admin account (created on startup if no admin exists; use a strong password, then remove these)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Payments: sandbox (test, default in dev) | manual (EFT, admin confirms, default in production) | paystack
PAYMENTS_MODE=
PAYSTACK_SECRET=
# Public URL of the site, used for payment redirects
APP_URL=

# Company details (shown on invoices, Terms and Privacy pages). Set COMPANY_NAME to remove the "draft" banner.
COMPANY_NAME=
COMPANY_REG=
VAT_NUMBER=
COMPANY_ADDRESS=
SUPPORT_EMAIL=support@talentbridge.co.za
SUPPORT_PHONE=
INFO_OFFICER=
# Email (SMTP). Without this, emails (verification, password reset, notifications) are NOT sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TalentBridge <no-reply@talentbridge.co.za>
# Daily database backups to <data>/backups in production (set false to disable)
BACKUP_DAILY=true
