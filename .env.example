PORT=3000
NODE_ENV=development
# REQUIRED in production: long random string (e.g. `openssl rand -hex 48`)
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
DB_PATH=./data/siira.db
# Comma-separated list of allowed origins; leave empty to allow same-origin only in production
CORS_ORIGIN=
# Demo data (public password!): on by default in development, OFF in production unless set to true
SEED_DEMO=true
