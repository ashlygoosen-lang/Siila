PORT=3000
NODE_ENV=development
# REQUIRED in production: long random string (e.g. `openssl rand -hex 48`)
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
DB_PATH=./data/siira.db
# Comma-separated list of allowed origins; leave empty to allow same-origin only in production
CORS_ORIGIN=
# Seed demo data on first start when the database is empty
SEED_DEMO=true

# First admin account (created on startup if no admin exists; use a strong password, then remove these)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Payments: payfast (card + Instant EFT, recommended) | manual (EFT, admin confirms; default in production) | sandbox (simulated, dev) | paystack
PAYMENTS_MODE=payfast
# PayFast: from your PayFast dashboard (Settings > Developer settings). Set the same passphrase there.
# Test with your own free sandbox account (sandbox.payfast.co.za) and PAYFAST_SANDBOX=true; use live details and false to take real payments.
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYSTACK_SECRET=
# Public https address of the site, used for PayFast return/notify links and email links
APP_URL=

# Company details (shown on invoices, Terms and Privacy pages). Set COMPANY_NAME to remove the "draft" banner.
COMPANY_NAME=
COMPANY_REG=
VAT_NUMBER=
COMPANY_ADDRESS=
SUPPORT_EMAIL=support@talentbridge.co.za
SUPPORT_PHONE=
INFO_OFFICER=
# Email (SMTP). Without this, emails (verification, password reset, notifications) are NOT sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TalentBridge <no-reply@talentbridge.co.za>
# Daily database backups to <data>/backups in production (set false to disable)
BACKUP_DAILY=true

# Identity verification (KYC)
# 64 hex characters. Encrypts ID documents, ID numbers and bank details. Generate with: openssl rand -hex 32
# Back this up somewhere safe: if it is lost, stored documents can never be decrypted.
DATA_KEY=
# Payments at or above this amount (rand) are held for anti-money-laundering review
AML_REVIEW_THRESHOLD=50000
# Set to false only for local testing to skip the verification gates
KYC_REQUIRED=true

# International hiring
# Days a long-term job must be open to South Africans before it can be opened to foreign nationals
SPONSOR_WAIT_DAYS=90
# Visa agent shown on sponsored hires (optional for employers)
VISA_AGENT_NAME=GlobalPath Immigration
VISA_AGENT_URL=https://globalpath-production.up.railway.app
VISA_AGENT_FEE=10000
